# Rotor local environment template.
# Copy this file to `.env` at the repo root and fill in real values there.
# `.env` is gitignored; do not commit private keys, API secrets, or tokens.
#
# Deploying on a host that injects secrets as environment variables (e.g. Manus)?
# Use `.env.manus.example` as the exact name manifest and see docs/manus.md.
# Optional: if a platform injects secrets under a namespace prefix, set
# ROTOR_ENV_PREFIX so `<PREFIX>SERA_API_KEY` resolves for `SERA_API_KEY` etc.
# ROTOR_ENV_PREFIX=

# Sera API. Testnet is the safe default for development and test runs.
SERA_BASE_URL=https://api.testnet.sera.cx/api/v1
SERA_API_KEY=
SERA_API_SECRET=

# Maker wallet used by `rotor mm vl` live mode.
SERA_PRIVATE_KEY=

# Tiny unresolved-state DB. This is not trade history. It belongs to the first
# wallet and network that use it; use one file per wallet and network.
ROTOR_STATE_PATH=.rotor_state.sqlite

# Price references. Each [[pair]] picks its source with `price_source` (`wise`,
# `ecb`, `fed`, or `bnm`; `wise` when omitted).
# Wise (POST /v3/quotes) supplies the after-fee prices every pair's normal quotes
# are placed at, and the mid for currencies no central-bank source covers. The token is
# optional: Wise prices anonymous quotes too, and a token only raises its limits.
WISE_API_TOKEN=
WISE_BASE_URL=https://api.wise.com
ECB_RATES_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
# Fed H.10 rates use the official FRED API (api.stlouisfed.org). It needs a free
# key from https://fred.stlouisfed.org/docs/api/api_key.html — the legacy
# fredgraph.csv scrape endpoint is bot-walled and unreliable from servers.
FRED_API_KEY=
FRED_API_BASE_URL=https://api.stlouisfed.org/fred/series/observations
# Replaces the built-in series (AUD BRL CAD CHF EUR GBP JPY MXN MYR NZD SGD ZAR);
# ids must be DEXUS<cc> (USD per unit) or DEX<cc>US (units per USD).
# FED_H10_SERIES_JSON='{"EUR":"DEXUSEU","GBP":"DEXUSUK","SGD":"DEXSIUS"}'
BNM_EXCHANGE_RATE_BASE_URL=https://api.bnm.gov.my/public/exchange-rate

# Optional token-to-ISO overrides for .env deployments.
# Example: PRICE_REFERENCE_TOKEN_TO_ISO_JSON='{"GBPT":"GBP","PHPX":"PHP"}'
PRICE_REFERENCE_TOKEN_TO_ISO_JSON=

# Per-source staleness windows (seconds). Each source defaults to its own window
# (wise ~600s; ecb/fed/bnm ~172800s = 48h, since they publish once per
# business day). Override one source, or all of them with PRICE_REFERENCE_MAX_AGE_S.
# The CLI flag --max-reference-age overrides every source when set.
# WISE_MAX_AGE_S=600
# ECB_MAX_AGE_S=172800
# FED_MAX_AGE_S=172800
# BNM_MAX_AGE_S=172800
# PRICE_REFERENCE_MAX_AGE_S=

# Stale carry-forward limits (seconds). Daily sources (ecb/fed/bnm) publish
# nothing on weekends or holidays, so a stale daily rate is still quoted on, with
# a Telegram warning, until it is this old (default 604800s = 7 days). wise never
# carries a stale quote; these limits do not apply to it. Past the limit the
# pair uses Wise's live mid instead. `rotor mm vl --halt-on-stale-reference`
# disables carrying for every source.
# BNM_MAX_CARRY_AGE_S=604800
# PRICE_REFERENCE_MAX_CARRY_AGE_S=

# Telegram alerts. Enable at runtime with `rotor mm vl --telegram`.
# Leave TELEGRAM_TOKEN empty to keep notification sends log-only.
TELEGRAM_TOKEN=
TELEGRAM_NORMAL_CHAT_ID=
TELEGRAM_IMPORTANT_CHAT_ID=
TELEGRAM_DEBUG_CHAT_ID=

# Live public FX source checks (ecb/fed/bnm; no credentials needed).
# `make live-prices` or ROTOR_RUN_LIVE_PRICES=1 pytest -q tests/live
ROTOR_RUN_LIVE_PRICES=0

# Real Sera testnet checks. Keep gates off until you intentionally run them.
ROTOR_RUN_TESTNET=0
ROTOR_RUN_TESTNET_E2E=0
ROTOR_RUN_TESTNET_SCENARIOS=0
ROTOR_TESTNET_ACK_LIVE_ORDER_RISK=0

# Common testnet inputs.
ROTOR_TESTNET_OWNER_ADDRESS=
# Live-order tests need markets nobody else trades: the taker must fill the
# maker, not other resting orders (Sepolia XSGD/USDC has an outside book).
ROTOR_TESTNET_MARKET=MYRT/USDC
ROTOR_TESTNET_SECOND_MARKET=CADC/USDC
# At least each market's minimum (Sepolia CADC/USDC: 12.11 CADC per ask).
ROTOR_TESTNET_QTY_BASE=20
# Near each market's real rate (MYR/USD, CAD/USD): testnet bots take quotes far from it.
ROTOR_TESTNET_PRICE=0.245
ROTOR_TESTNET_SECOND_PRICE=0.714
ROTOR_TESTNET_MID=0.245
ROTOR_TESTNET_SECOND_MID=0.714

# Two-wallet live testnet flow. Maker and taker must be distinct funded wallets.
ROTOR_TESTNET_MAKER_PRIVATE_KEY=
ROTOR_TESTNET_MAKER_API_KEY=
ROTOR_TESTNET_MAKER_API_SECRET=
ROTOR_TESTNET_TAKER_PRIVATE_KEY=
ROTOR_TESTNET_TAKER_API_KEY=
ROTOR_TESTNET_TAKER_API_SECRET=

# Optional testnet overrides.
ROTOR_TESTNET_FIXED_BPS=50
ROTOR_TESTNET_RETURN_BPS=1
ROTOR_TESTNET_BUDGET_AMOUNT=1000000
ROTOR_TESTNET_ORDER_TTL=600
ROTOR_TESTNET_FILL_WAIT_SECONDS=20
ROTOR_TESTNET_SCENARIO_BETWEEN_TICKS_SECONDS=305
ROTOR_TESTNET_CLEANUP_WAIT_SECONDS=0
ROTOR_TESTNET_TIMEOUT=15
