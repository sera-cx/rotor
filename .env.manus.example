# Rotor on Manus — secret-store manifest
#
# Manus stores the values you add to its secret store and injects them into the
# sandbox as ENVIRONMENT VARIABLES under the exact name you give them. Rotor reads
# config environment-first, so register each secret below using the EXACT name
# shown here — no renaming, no guessing.
#
# This file lists names only (no values). Add the values in the Manus secret
# store, not in this file.
#
# If (and only if) Manus injects your secrets under a namespace prefix, set
# ROTOR_ENV_PREFIX to that prefix; rotor will then resolve `<PREFIX>SERA_API_KEY`
# for `SERA_API_KEY`, etc. Leave it unset when names are injected bare.
# ROTOR_ENV_PREFIX=

# ----- Required: Sera (live trading) -----
SERA_BASE_URL=        # must be https:// (e.g. https://api.testnet.sera.cx/api/v1)
SERA_API_KEY=
SERA_API_SECRET=
SERA_PRIVATE_KEY=     # 0x-prefixed maker key — the most sensitive value

# ----- Optional: price source -----
# Wise is used for every pair (its after-fee rates) and works without a token;
# one only raises Wise's rate limits.
WISE_API_TOKEN=
# Only if a pair uses price_source = fed:
# FRED_API_KEY=

# ----- Recommended -----
# Point state at a persistent path. Open orders are recovered from Sera on each
# boot, but positions held for return and fills still to be counted live only
# in this file; losing it forgets them. It belongs to the first wallet and
# network that use it: use one file per wallet and network.
ROTOR_STATE_PATH=.rotor_state.sqlite

# ----- Optional -----
# TELEGRAM_TOKEN=              # with --telegram
# TELEGRAM_NORMAL_CHAT_ID=
# TELEGRAM_IMPORTANT_CHAT_ID=
# TELEGRAM_DEBUG_CHAT_ID=
